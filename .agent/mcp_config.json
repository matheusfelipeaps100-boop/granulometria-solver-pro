{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        },
        "supabase": {
            "type": "http",
            "url": "https://mcp.supabase.com/mcp?project_ref=lhfxcjwpsjnpmgyyhbxi",
            "headers": {
                "Authorization": "Bearer ${SUPABASE_ACCESS_TOKEN}"
            }
        }
    }
}
