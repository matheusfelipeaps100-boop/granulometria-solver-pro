## 10. SCHEMA DO BANCO DE DADOS

### Tabela principal: `analises`
```sql
CREATE TABLE public.analises (
  id               UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  code             TEXT,                    -- Ex: AN-2026-001
  name             TEXT NOT NULL,           -- Nome da análise
  date             DATE,                    -- Data da análise
  author           TEXT,                    -- Analista responsável
  type             TEXT CHECK (type IN ('BLOCOS','PAVERS')),
  status           TEXT,                    -- 'Rascunho' | 'Aprovado' | 'Em Revisão'
  producao_status  TEXT,                    -- 'Aguardando' | 'Em Produção' | 'Finalizado'
  materials_data   JSONB,  -- Array[] para BLOCOS | {base:[], face:[]} para PAVERS
  selected_tracos  JSONB,
  dosagem_config   JSONB,  -- {volumeBatelada, densidadeCimento, cimentoTarget, tracos[]}
  observations     TEXT,
  recipe_dna_id      UUID REFERENCES recipe_dna(id),  -- DNA do Bloco
  recipe_dna_base_id UUID REFERENCES recipe_dna(id),  -- DNA da Base (Paver)
  recipe_dna_face_id UUID REFERENCES recipe_dna(id),  -- DNA da Face (Paver)
  created_at       TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);
```

### Tabela: `aggregate_bank` (Banco de Agregados)
```sql
CREATE TABLE public.aggregate_bank (
  id          UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id     UUID DEFAULT auth.uid(),
  name        TEXT NOT NULL,   -- Ex: "Areia Fina Guariroba"
  density     DECIMAL NOT NULL,
  created_at  TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE TABLE public.aggregate_bank_sieve_data (
  id              UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  aggregate_id    UUID REFERENCES aggregate_bank(id) ON DELETE CASCADE,
  sieve_size      TEXT NOT NULL,           -- Ex: "2.4", "0.6", "Fundo"
  percent_retained DECIMAL NOT NULL (0-100),
  created_at      TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);
```

### Tabela: `recipe_dna` (DNA de Receitas)
```sql
CREATE TABLE public.recipe_dna (
  id         UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_id    UUID DEFAULT auth.uid(),
  name       TEXT NOT NULL,              -- Ex: "DNA Bloco 09x19x39 Padrão"
  target_mf  DECIMAL,                   -- Módulo de Finura alvo
  type       TEXT CHECK (type IN ('BE','PV')),  -- Bloco Estrutural | Paver
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE TABLE public.recipe_dna_sieve_data (
  id              UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  recipe_id       UUID REFERENCES recipe_dna(id) ON DELETE CASCADE,
  sieve_size      TEXT NOT NULL,
  percent_passing DECIMAL NOT NULL (0-100),  -- DNA usa PASSANTE (≠ retido)
  created_at      TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);
```

> [!IMPORTANT]
> **Convenção crítica:** O banco de agregados armazena `percent_retained` (retido), mas o DNA de receitas armazena `percent_passing` (passante). O solver converte automaticamente: `retido = 100 - passante`.

### Schema Prisma equivalente
```prisma
model Analise {
  id               String   @id @default(uuid())
  code             String?
  name             String
  date             String?
  author           String?
  type             String   // "BLOCOS" | "PAVERS"
  status           String?  // "Rascunho" | "Aprovado" | "Em Revisão"
  producaoStatus   String?  // "Aguardando" | "Em Produção" | "Finalizado"
  materialsData    Json?
  selectedTracos   Json?
  dosagemConfig    Json?
  observations     String?
  recipeDnaId      String?
  recipeDnaBaseId  String?
  recipeDnaFaceId  String?
  createdAt        DateTime @default(now())

  recipeDna        RecipeDna? @relation("DnaBloco",   fields:[recipeDnaId],     references:[id])
  recipeDnaBase    RecipeDna? @relation("DnaBase",    fields:[recipeDnaBaseId], references:[id])
  recipeDnaFace    RecipeDna? @relation("DnaFace",    fields:[recipeDnaFaceId], references:[id])
}

model AggregateBank {
  id        String   @id @default(uuid())
  name      String
  density   Float
  createdAt DateTime @default(now())
  sieves    AggregateSieve[]
}

model AggregateSieve {
  id             String        @id @default(uuid())
  aggregateId    String
  sieveSize      String
  percentRetained Float
  aggregate      AggregateBank @relation(fields:[aggregateId], references:[id], onDelete:Cascade)
}

model RecipeDna {
  id       String  @id @default(uuid())
  name     String
  targetMf Float?
  type     String  // "BE" | "PV"
  sieves   RecipeDnaSieve[]
}

model RecipeDnaSieve {
  id             String    @id @default(uuid())
  recipeId       String
  sieveSize      String
  percentPassing Float
  recipe         RecipeDna @relation(fields:[recipeId], references:[id], onDelete:Cascade)
}
```

